<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Box style="flex-grow: 1; flex-direction: row; margin: 0px; padding: 0px; height: 19px; background-color: transparent;" name="toggle-container">
        <ui:Toggle name="target-toggle" style="margin-left: 0px; margin-top: 1px; margin-bottom: 1px; padding: 0px; height: 15px;" />
        <ui:Label name="target-label" style="margin-top: 1px; margin-bottom: 1px; padding: 0px; height: 15px;"  tabindex="-1" parse-escape-sequences="true" display-tooltip-when-elided="true" />
    </ui:Box>
</ui:UXML>
